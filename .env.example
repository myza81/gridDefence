# Copy this file to .env (at the repository root) and adjust values for your
# local environment. Do not commit .env — it is git-ignored. No secrets are
# stored in this example file (CLAUDE.md §22).
#
# This root .env is the single source of truth for both Docker Compose (which
# reads it automatically) and local, non-Docker backend runs (see
# backend/app/core/config.py, which resolves it by absolute path regardless
# of which directory you run commands from) — see docs/development/
# postgresql-setup.md for the full setup walkthrough.

# --- Database ---------------------------------------------------------------
# POSTGRES_* configure Docker Compose's own containerized PostgreSQL service
# on first init. For a local, non-Docker PostgreSQL install, these three
# variables are not read directly — only DATABASE_URL matters — but keeping
# them consistent with DATABASE_URL avoids two different sets of credentials
# to remember.
POSTGRES_USER=engineering_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=engineering_platform

# Used by the backend directly (SQLAlchemy + Alembic). When running via
# Docker Compose, the host is the `postgres` service name; when running the
# backend locally against either a local PostgreSQL install or the
# Dockerised database (with its port published to the host), use `localhost`.
DATABASE_URL=postgresql+psycopg://engineering_app:changeme@localhost:5432/engineering_platform

# --- Backend ------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=5173

# --- General --------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development

# --- IAM (Phase 1) --------------------------------------------------------------
# Signs local-login access tokens (app/modules/iam/security.py). Generate a
# real random value per deployment — never reuse the development default.
SECRET_KEY=insecure-development-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=28800

# Bootstrap Administrator (app/modules/iam/bootstrap.py) — used only on first
# run, when no Administrator-role user exists yet. Change the password after
# first login; this is not read again once bootstrap has run.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
BOOTSTRAP_ADMIN_EMAIL=
