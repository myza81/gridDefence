# Copy this file to .env and adjust values for your local environment.
# Do not commit .env — it is git-ignored. No secrets are stored in this
# example file (CLAUDE.md §22).

# --- Database ---------------------------------------------------------------
POSTGRES_USER=griddefence
POSTGRES_PASSWORD=griddefence
POSTGRES_DB=griddefence

# Used by the backend directly. When running via Docker Compose, the host is
# the `postgres` service name; when running the backend locally against the
# Dockerised database, use `localhost` instead.
DATABASE_URL=postgresql+psycopg://griddefence:griddefence@localhost:5432/griddefence

# --- Backend ------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=5173

# --- General --------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development

# --- IAM (Phase 1) --------------------------------------------------------------
# Signs local-login access tokens (app/modules/iam/security.py). Generate a
# real random value per deployment — never reuse the development default.
SECRET_KEY=insecure-development-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=28800

# Bootstrap Administrator (app/modules/iam/bootstrap.py) — used only on first
# run, when no Administrator-role user exists yet. Change the password after
# first login; this is not read again once bootstrap has run.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
BOOTSTRAP_ADMIN_EMAIL=
